# ---------------------------------------------------------------------------
# Operator-note interpretation is served by two independent providers on
# separate quotas. Configure either one, or both for redundancy. All models
# are raced concurrently and the first valid answer wins.
# ---------------------------------------------------------------------------

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-pro-preview

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b,groq/compound-mini

# Per-model request timeout in seconds.
LLM_TIMEOUT_S=10

# Total interpretation budget in seconds (kept under the 30s judge timeout).
LLM_TOTAL_BUDGET_S=7

# Port the API binds to.
PORT=8000
