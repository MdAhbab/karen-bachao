# Google Gemini API key used for operator-note interpretation.
# Get one at https://aistudio.google.com/apikey — never commit the real value.
GEMINI_API_KEY=

# Ordered fallback chain. The service races the first two, then cascades.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-pro-preview

# Per-model request timeout in seconds.
LLM_TIMEOUT_S=10

# Total interpretation budget in seconds (kept under the 30s judge timeout).
LLM_TOTAL_BUDGET_S=11

# Port the API binds to.
PORT=8000
